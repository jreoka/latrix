#!/bin/bash
# Minimal systemctl stand-in for the test containers (no systemd inside).
cmd="${1:-}"; shift || true
svc=""
has_now=0
for a in "$@"; do
  case "$a" in
    --now) has_now=1 ;;
    -*) ;;
    *) svc="${a%.service}" ;;
  esac
done
start_latrix() { pkill -f '[l]atrix agent run' || true; sleep 1; setsid nohup /usr/local/bin/latrix agent run </dev/null >>/var/log/latrix.log 2>&1 & }
case "$cmd" in
  daemon-reload) exit 0 ;;
  enable) [ "$has_now" = 1 ] && [ "$svc" = latrix ] && start_latrix; exit 0 ;;
  disable) [ "$has_now" = 1 ] && [ "$svc" = latrix ] && (pkill -f '[l]atrix agent run' || true); exit 0 ;;
  is-active) if [ "$svc" = docker ]; then pgrep -x dockerd >/dev/null; else pgrep -f '[l]atrix agent run' >/dev/null; fi ;;
  start|restart)
    if [ "$svc" = latrix ]; then start_latrix
    elif [ "$svc" = docker ] && [ "$cmd" = restart ]; then
      pkill -x dockerd || true; for _ in $(seq 1 20); do pgrep -x dockerd >/dev/null || break; sleep 1; done
      rm -f /var/run/docker.pid; setsid dockerd >>/var/log/dockerd.log 2>&1 < /dev/null &
      for _ in $(seq 1 30); do docker info >/dev/null 2>&1 && break; sleep 1; done
    fi
    exit 0 ;;
  stop) [ "$svc" = latrix ] && (pkill -f '[l]atrix agent run' || true); exit 0 ;;
  *) exit 0 ;;
esac
